# Credentials & tunables for the k6 suite.
#
# Copy to .env, fill in the passwords (left blank on purpose), then run via the
# loader (which reads .env and hands the vars to k6):
#   ./run.sh tests/ops.test.js
#   npm run test:ops
#
# .env is git-ignored so your real passwords are never committed.
# dotenv format: KEY=value, one per line, no `export`, values taken literally.

# --- nginx Basic Auth (the browser prompt credential) ----------------------
BASIC_AUTH_USER=tf
BASIC_AUTH_PASS=              # <- fill in

# --- Application logins -----------------------------------------------------
# All roles authenticate via POST /api/auth/login (JSON) and land on their
# dashboard. Passwords are only needed for the role(s) you intend to test.
OPS_USER=ops@tf.com
OPS_PASS=                     # <- fill in  -> first URL /ops/dashboard
EMPLOYER_USER=shah_ali@cloudly.io
EMPLOYER_PASS=                # <- fill in  -> first URL /employer/dashboard
WORKER_USER=shahali@cloudly.io
WORKER_PASS=                  # <- fill in  -> first URL /worker/dashboard

# --- Optional overrides ------------------------------------------------------
# BASE_URL=https://tf.cloudly.io
# LOGIN_API_PATH=/api/auth/login
# LOGIN_USER_FIELD=email
# LOGIN_PASS_FIELD=password
# MODE=stress                 # stress | level
# LEVEL=250                   # used when MODE=level
# LEVEL_DURATION=90s
# RAMP_UP=5s
# HOLD=10s
# PEAK_HOLD=20s
